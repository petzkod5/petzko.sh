{
  "compilerOptions": {
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "lib": ["es2022"],
    // Runtime types come from the wrangler-generated worker-configuration.d.ts
    // (version-matched to compatibility_date), not @cloudflare/workers-types.
    "types": [],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true
  },
  // worker-configuration.d.ts is generated by `wrangler types` (provides Env).
  "include": ["src/**/*.ts", "worker-configuration.d.ts"]
}
