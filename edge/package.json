{
  "name": "petzko-edge",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "typecheck": "wrangler types && tsc --noEmit",
    "migrate:local": "wrangler d1 migrations apply petzko-stats --local",
    "migrate:remote": "wrangler d1 migrations apply petzko-stats --remote"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "wrangler": "^4.103.0"
  }
}
